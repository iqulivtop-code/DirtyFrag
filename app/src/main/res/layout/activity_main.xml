<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Toolbar -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:elevation="4dp">

        <TextView
            android:id="@+id/odinLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DirtyFrag"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/menuAnchor"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_menu"
            android:scaleType="centerInside"
            android:contentDescription="Menu" />
    </LinearLayout>

    <!-- Dim Overlay for Popups -->
    <View
        android:id="@+id/dimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:elevation="20dp" />

    <!-- Card Stack Container -->
    <df.root.CardStackLayout
        android:id="@+id/cardStack"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar"
        android:layout_above="@id/bottomBar"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp">

        <!-- 1. Fetch KernelSU Card -->
        <df.root.DraggableCardView
            android:id="@+id/cardFetchKsu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:id="@+id/rowFetchKsu"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:background="@drawable/card_bg"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_download"
                    android:tint="#FFFFFF"
                    android:contentDescription="Fetch KSU" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fetch KernelSU"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Download latest releases from GitHub"
                        android:textColor="#9E9E9E"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="#6E6E6E"
                    android:contentDescription="Open" />
            </LinearLayout>
        </df.root.DraggableCardView>

        <!-- 2. SU Manager Card -->
        <df.root.DraggableCardView
            android:id="@+id/cardSuManager"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:id="@+id/rowSuManager"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:background="@drawable/card_bg"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_shield"
                    android:tint="#FFFFFF"
                    android:contentDescription="SU Manager" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SU Manager"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/suManagerSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Not selected - required"
                        android:textColor="#E57373"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="#6E6E6E"
                    android:contentDescription="Open" />
            </LinearLayout>
        </df.root.DraggableCardView>

        <!-- 3. Boot / Autorun Card -->
        <df.root.DraggableCardView
            android:id="@+id/cardBoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvAutorunTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Autorun"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvAutorunDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Start exploit automatically on boot"
                            android:textColor="#9E9E9E"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <df.root.OneUiSwitch
                        android:id="@+id/switchBootStart"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#1F1F1F"
                    android:layout_marginVertical="14dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvRebootTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Auto soft reboot"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvRebootDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Reboot userspace automatically after root"
                            android:textColor="#9E9E9E"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <df.root.OneUiSwitch
                        android:id="@+id/switchAutoSoftReboot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </df.root.DraggableCardView>

        <!-- 4. Modules Card -->
        <df.root.DraggableCardView
            android:id="@+id/cardModules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="20dp"
                android:background="@drawable/card_bg">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        text="KernelSU Modules"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/modulesSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enabled - Active at next reroot"
                        android:textColor="#9E9E9E"
                        android:textSize="13sp" />
                </LinearLayout>

                <df.root.OneUiSwitch
                    android:id="@+id/switchModules"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </df.root.DraggableCardView>

        <!-- 5. Log & Settings Card -->
        <df.root.DraggableCardView
            android:id="@+id/cardLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Advanced log"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Show detailed execution output"
                            android:textColor="#9E9E9E"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <df.root.OneUiSwitch
                        android:id="@+id/switchAdvancedLog"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </df.root.DraggableCardView>

    </df.root.CardStackLayout>

    <!-- Floating Log Window Layer -->
    <ScrollView
        android:id="@+id/logWindow"
        android:layout_width="match_parent"
        android:layout_height="@dimen/log_window_height"
        android:layout_above="@id/bottomBar"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/log_window_bg"
        android:padding="16dp"
        android:visibility="gone"
        android:elevation="12dp">

        <TextView
            android:id="@+id/outputView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#B3B3B3"
            android:textSize="12sp" />
    </ScrollView>

    <!-- Bottom Action Bar -->
    <RelativeLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_alignParentBottom="true"
        android:paddingHorizontal="16dp"
        android:background="#000000"
        android:elevation="15dp">

        <!-- Two Step Progress Indicator -->
        <df.root.TwoStepProgressView
            android:id="@+id/twoStep"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_centerInParent="true" />

        <!-- Run / Action Button -->
        <Button
            android:id="@+id/btnRun"
            android:layout_width="160dp"
            android:layout_height="54dp"
            android:layout_centerVertical="true"
            android:backgroundTint="#7A7A7A"
            android:text="Run exploit"
            android:textColor="#E0E0E0"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:elevation="2dp" />

        <!-- Share Log Button -->
        <ImageButton
            android:id="@+id/btnShareLog"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle_button"
            android:src="@drawable/ic_share"
            android:scaleType="centerInside"
            android:tint="#FFFFFF"
            android:visibility="gone"
            android:contentDescription="Share Log"
            android:elevation="3dp" />

        <!-- KernelSU Quick Launch Button -->
        <FrameLayout
            android:id="@+id/btnKsu"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle_button"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            android:elevation="3dp">

            <ImageView
                android:id="@+id/ksuChevron"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_chevron_right"
                android:tint="#6E6E6E"
                android:contentDescription="Open KSU" />

            <TextView
                android:id="@+id/ksuLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="KernelSU"
                android:textColor="#1F1F1F"
                android:textSize="13sp"
                android:textStyle="bold"
                android:alpha="0" />
        </FrameLayout>

        <!-- Odin / Recovery Pill Status -->
        <LinearLayout
            android:id="@+id/odinPill"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:background="@drawable/odin_pill_bg"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <View
                android:id="@+id/odinDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/dot_white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Recovery"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </RelativeLayout>

</RelativeLayout>
