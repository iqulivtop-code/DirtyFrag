<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Верхний Toolbar -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/odinLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DFRoot"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/menuAnchor"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more"
            android:contentDescription="Menu" />
    </LinearLayout>

    <View
        android:id="@+id/dimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone" />

    <!-- Основной стек карточек -->
    <df.root.CardStackLayout
        android:id="@+id/cardStack"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar"
        android:layout_above="@id/bottomBar"
        android:padding="16dp">

        <!-- Карточка Fetch KSU -->
        <df.root.DraggableCardView
            android:id="@+id/cardFetchKsu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:id="@+id/rowFetchKsu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_share"
                    android:contentDescription="Fetch" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Fetch KernelSU"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron"
                    android:contentDescription="Chevron" />
            </LinearLayout>
        </df.root.DraggableCardView>

        <!-- Карточка SU Manager -->
        <df.root.DraggableCardView
            android:id="@+id/cardSuManager"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:id="@+id/rowSuManager"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_launcher_foreground"
                    android:contentDescription="SU" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SU Manager"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/suManagerSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Not installed"
                        android:textColor="#888888"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron"
                    android:contentDescription="Chevron" />
            </LinearLayout>
        </df.root.DraggableCardView>

        <!-- Карточка Boot / Autorun -->
        <df.root.DraggableCardView
            android:id="@+id/cardBoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAutorunTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Autorun"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvAutorunDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Execute scripts on boot"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp" />

                <df.root.OneUiSwitch
                    android:id="@+id/switchBootStart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tvRebootTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auto Soft Reboot"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:layout_marginTop="12sp" />

                <TextView
                    android:id="@+id/tvRebootDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reboot system automatically"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp" />

                <df.root.OneUiSwitch
                    android:id="@+id/switchAutoSoftReboot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </df.root.DraggableCardView>

        <!-- Карточка Modules -->
        <df.root.DraggableCardView
            android:id="@+id/cardModules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Modules"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/modulesSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manage system extensions"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp" />

                <df.root.OneUiSwitch
                    android:id="@+id/switchModules"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </df.root.DraggableCardView>

        <!-- Карточка Log / Output -->
        <df.root.DraggableCardView
            android:id="@+id/cardLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <df.root.OneUiSwitch
                    android:id="@+id/switchAdvancedLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp" />

                <ScrollView
                    android:id="@+id/logWindow"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:background="@drawable/popup_bg"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/outputView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ready..."
                        android:textColor="#00FF00"
                        android:textSize="12sp"
                        android:fontFamily="monospace" />
                </ScrollView>
            </LinearLayout>
        </df.root.DraggableCardView>

    </df.root.CardStackLayout>

    <!-- Нижняя панель управления -->
    <RelativeLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:padding="16dp">

        <df.root.TwoStepProgressView
            android:id="@+id/twoStep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnRun"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Run"
            android:layout_below="@id/twoStep" />

        <ImageButton
            android:id="@+id/btnShareLog"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_share"
            android:background="@drawable/bg_circle"
            android:layout_alignParentEnd="true"
            android:visibility="gone"
            android:contentDescription="Share" />

        <FrameLayout
            android:id="@+id/btnKsu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ksuChevron"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_chevron"
                android:contentDescription="KSU Chevron" />

            <TextView
                android:id="@+id/ksuLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/odinPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_odin_pill"
            android:visibility="gone"
            android:orientation="horizontal">

            <View
                android:id="@+id/odinDot"
                android:layout_width="8dp"
                android:layout_height="8dp" />
        </LinearLayout>
    </RelativeLayout>

</RelativeLayout>
