<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A">

    <!-- Верхний Toolbar -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/odinLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="KurwaSU"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/menuAnchor"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more"
            android:contentDescription="Menu" />
    </LinearLayout>

    <View
        android:id="@+id/dimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone" />

    <!-- Основной стек карточек -->
    <df.root.CardStackLayout
        android:id="@+id/cardStack"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar"
        android:layout_above="@id/bottomBar"
        android:padding="16dp">

        <!-- Карточка SU Manager -->
        <df.root.DraggableCardView
            android:id="@+id/cardSuManager"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:id="@+id/rowSuManager"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SU Manager"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/suManagerSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Not selected - required"
                        android:textColor="#FF5555"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron"
                    android:contentDescription="Chevron" />
            </LinearLayout>
        </df.root.DraggableCardView>

        <!-- Карточка Autorun -->
        <df.root.DraggableCardView
            android:id="@+id/cardBoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAutorunTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Autorun (Expert)"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAutorunDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Runs the exploit after boot"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp" />

                <df.root.OneUiSwitch
                    android:id="@+id/switchBootStart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tvRebootTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auto reboot (Expert)"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/tvRebootDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Soft reboots after root"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp" />

                <df.root.OneUiSwitch
                    android:id="@+id/switchAutoSoftReboot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </df.root.DraggableCardView>

        <!-- Карточка KernelSU Modules -->
        <df.root.DraggableCardView
            android:id="@+id/cardModules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KernelSU Modules"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/modulesSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enabled - Active at next reroot"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp" />

                <df.root.OneUiSwitch
                    android:id="@+id/switchModules"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </df.root.DraggableCardView>

        <!-- Карточка логов -->
        <df.root.DraggableCardView
            android:id="@+id/cardLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Show advanced log"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shows full scrollable log"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp" />

                <df.root.OneUiSwitch
                    android:id="@+id/switchAdvancedLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp" />

                <ScrollView
                    android:id="@+id/logWindow"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:background="@drawable/popup_bg"
                    android:padding="8dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/outputView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ready..."
                        android:textColor="#00FF00"
                        android:textSize="12sp"
                        android:fontFamily="monospace" />
                </ScrollView>
            </LinearLayout>
        </df.root.DraggableCardView>

    </df.root.CardStackLayout>

    <!-- Нижняя панель и подпись автора -->
    <RelativeLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:padding="16dp">

        <df.root.TwoStepProgressView
            android:id="@+id/twoStep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnRun"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_below="@id/twoStep"
            android:background="@drawable/bg_pill"
            android:text="Rooted"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Копирайт -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/btnRun"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="8dp"
            android:text="Created by @kurwakid1337"
            android:textColor="#666666"
            android:textSize="11sp" />

        <ImageButton
            android:id="@+id/btnShareLog"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_share"
            android:background="@drawable/bg_circle"
            android:layout_alignParentEnd="true"
            android:visibility="gone"
            android:contentDescription="Share" />
    </RelativeLayout>

</RelativeLayout>
